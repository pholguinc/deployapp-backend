# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/deployapp_db?schema=public"

# Application
PORT=3000
NODE_ENV=development

# Swagger / OpenAPI
SWAGGER_ROUTE=/docs
SWAGGER_TITLE="DeployApp API"
SWAGGER_DESCRIPTION="DeployApp Backend API Documentation"
SWAGGER_VERSION="1.0.0"
SWAGGER_SERVERS="http://localhost:3000"

# JWT Configuration
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Seeder
SUPERADMIN_EMAIL="superadmin@deployapp.com"
SUPERADMIN_PASSWORD="SuperAdmin123*"
SUPERADMIN_NAME="Super Administrador"

# S3 Configuration (Flocui, AWS, R2, etc.)
S3_ENDPOINT="https://your-s3-endpoint.com"
S3_REGION="us-east-1"
S3_BUCKET_NAME="deployapp-bucket"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
