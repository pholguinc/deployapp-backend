// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  name           String?
  lastname       String?
  phone          String?
  isActive       Boolean            @default(true)
  roleId         String?
  role           Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions       Session[]
  comments       Comment[]
  courses        UserCourse[]
  lessons        UserLesson[]
  taughtCourses  Course[]           @relation("CourseInstructor")
  courseReviews  CourseReview[]
  examAttempts   FinalExamAttempt[] @relation("UserAttempts")
  gradedAttempts FinalExamAttempt[] @relation("GradedAttempts")
  certificates   Certificate[]
  notifications  Notification[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Achievement {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  color     String?
  estado    Boolean  @default(true)
  orden     Int      @default(0)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("achievements")
}

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String?
  category     String?
  level        String?
  duration     String?
  lessonsCount Int      @default(0)
  rating       Float    @default(0)
  instructorId String?
  instructor   User?    @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  imageUrl     String?
  features     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules      Module[]
  users        UserCourse[]
  reviews      CourseReview[]
  finalExam    FinalExam?
  certificates Certificate[]

  @@map("courses")
}

model UserCourse {
  userId    String
  courseId  String
  status    String   @default("ENROLLED") // ENROLLED, COMPLETED
  progress  Int      @default(0) // percentage 0-100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("user_courses")
}

model UserLesson {
  userId    String
  lessonId  String
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("user_lessons")
}

model Module {
  id       String   @id @default(uuid())
  title    String
  order    Int      @default(0)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@map("modules")
}

model Lesson {
  id          String       @id @default(uuid())
  title       String
  duration    String? // e.g. "08:35 min"
  videoUrl    String?
  type        String       @default("VIDEO") // VIDEO, QUIZ, TEXT
  order       Int          @default(0)
  moduleId    String
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]
  comments    Comment[]
  quizzes     Quiz[]
  userLessons UserLesson[]

  @@map("lessons")
}

model Resource {
  id       String  @id @default(uuid())
  name     String
  type     String  @default("PDF")
  size     String? // e.g. "3.8 MB"
  url      String
  lessonId String
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  likes     Int      @default(0)
  lessonId  String
  userId    String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  lessonId  String
  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("quizzes")
}

model Question {
  id      String   @id @default(uuid())
  text    String
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model CourseReview {
  id        String   @id @default(uuid())
  rating    Int // 1 to 5
  comment   String?  @db.Text
  courseId  String
  userId    String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@map("course_reviews")
}

// --- FINAL EXAM ---

model FinalExam {
  id                    String              @id @default(uuid())
  courseId              String              @unique
  course                Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title                 String
  practicalTitle        String?             @default("Caso Práctico de Despliegue de Servicios")
  practicalInstructions String?             @db.Text
  practicalRubric       String?             @db.Text
  practicalGuideUrl     String?
  practicalPdfUrl       String?
  practicalPdfName      String?
  questions             FinalExamQuestion[]
  attempts              FinalExamAttempt[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("final_exams")
}

model FinalExamQuestion {
  id      String            @id @default(uuid())
  text    String
  examId  String
  exam    FinalExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options FinalExamOption[]

  @@map("final_exam_questions")
}

model FinalExamOption {
  id         String            @id @default(uuid())
  text       String
  isCorrect  Boolean           @default(false)
  questionId String
  question   FinalExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("final_exam_options")
}

model FinalExamAttempt {
  id     String  @id @default(uuid())
  userId String
  examId String
  score  Float // Puntuación promedio consolidada entre teórico y práctico
  total  Int // total preguntas teóricas
  passed Boolean @default(false)

  // Componente Teórico
  theoreticalScore   Float? // Nota teórico (0-20)
  theoreticalTotal   Int? // Total de preguntas teóricas
  theoreticalCorrect Int? // Respuestas correctas
  theoreticalPassed  Boolean @default(false)

  // Componente Práctico (PDF subido y calificado)
  practicalFileUrl     String? // URL del PDF del examen práctico
  practicalFileName    String? // Nombre del archivo PDF
  practicalSubmittedAt DateTime? // Fecha de envío del PDF
  practicalStatus      String    @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING_REVIEW, GRADED, REJECTED
  practicalScore       Float? // Nota práctico otorgada por el docente (0-20)
  practicalFeedback    String?   @db.Text
  practicalGradedAt    DateTime? // Fecha de calificación del docente
  gradedById           String?

  // Métricas de desempeño práctico registradas por el docente (fichas IND-02 e IND-03)
  practicalTasksEvaluated Int? // Tareas de despliegue evaluadas (n)
  practicalTotalMinutes   Float? // Tiempo total acumulado en resolver y desplegar (min)
  incidentsInjected       Int? // Incidencias inyectadas en el entorno de prueba
  incidentsResolved       Int? // Incidencias resueltas operativamente

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user     User      @relation("UserAttempts", fields: [userId], references: [id], onDelete: Cascade)
  exam     FinalExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  gradedBy User?     @relation("GradedAttempts", fields: [gradedById], references: [id], onDelete: SetNull)

  @@map("final_exam_attempts")
}

model Certificate {
  id       String   @id @default(uuid())
  userId   String
  courseId String
  score    Float
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  type      String   @default("COURSE_COMPLETED")
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}
